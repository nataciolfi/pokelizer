@startuml
set namespaceSeparator none
!pragma layout smetana
skinparam backgroundColor white
skinparam shadowing false
skinparam dpi 120
skinparam packageStyle rectangle
skinparam classAttributeIconSize 0
skinparam defaultFontName SansSerif
skinparam defaultFontSize 13
skinparam nodesep 45
skinparam ranksep 60
title Pokelizer — classes Python implementadas — Etapa 2
package "models.py" {
class Usuario {
  +id_usuario: int
  +to_public_dict()
}
class PokemonCatalogo {
  +id_dados_forma: int | None
  +id_especie: int
  +id_forma: int | None
  +id_jogo: int | None
  +codigo_forma: str | None
  +fichas: tuple[dict[str, Any], ...]
  +to_dict()
}
class PokemonColecao {
  +id_pokemon_colecao: int
  +id_usuario: int
  +id_dados_forma_atual: int
  +id_jogo_origem: int | None
  +id_metodo_obtencao: int | None
  +id_natureza: int | None
  +id_habilidade_forma: int | None
  +id_mecanica: int | None
  +id_dados_forma_origem: int | None
  +valores: tuple[dict[str, Any], ...]
  +to_dict()
}
class PerfilAnalise {
  +id_perfil: int
  +id_dados_forma: int
  +id_mecanica: int
  +id_usuario: int | None
  +id_regulamento: int | None
  +valores: tuple[dict[str, Any], ...]
  +naturezas: tuple[int, ...]
  +habilidades: tuple[int, ...]
  +to_dict()
}
}
package "dao.py" {
class UsuarioDAO {
  +criar()
  +obter_por_email()
  +obter_por_id()
}
class PokemonDAO {
  +listar()
  +listar_global()
  +obter_forma()
  +obter()
  -_row_to_model()
}
class ColecaoDAO {
  +adicionar()
  -_model()
  +atualizar_do_usuario()
  +listar_do_usuario()
  +obter_do_usuario()
  +excluir_do_usuario()
  +obter_contexto_registro()
  +metodo_disponivel()
  +habilidade_compativel()
}
class PerfilDAO {
  +obter_visivel()
  +criar_personalizado()
  +relacionados()
  +listar_visiveis()
  +atualizar_personalizado()
  +substituir_opcoes()
  +excluir_personalizado()
}
class ValorDAO {
  +listar()
  +substituir()
}
class ContextoDAO {
  +mecanica()
  +opcoes()
  +ficha()
}
class RegulamentoDAO {
  +listar()
  +obter()
  +elegibilidade()
}
}
package "services.py" {
class AuthService {
  +cadastrar()
  +autenticar()
}
class ColecaoService {
  +adicionar()
  +editar()
  -_preparar()
  -_id_opcional()
  -_inteiro_opcional()
  -_texto_opcional()
}
class PerfilService {
  -_preparar()
  -_opcoes()
  +criar_personalizado()
  +editar()
}
class ComparacaoService {
  +comparar()
}
}
AuthService ..> UsuarioDAO
ColecaoService ..> ColecaoDAO
ColecaoService ..> ValorDAO
PerfilService ..> PerfilDAO
PerfilService ..> ValorDAO
ComparacaoService ..> ColecaoDAO
ComparacaoService ..> PerfilDAO
ComparacaoService ..> ContextoDAO
ComparacaoService ..> RegulamentoDAO
UsuarioDAO ..> Usuario
ColecaoDAO ..> PokemonColecao
PerfilDAO ..> PerfilAnalise
PokemonDAO ..> PokemonCatalogo
note "api.py: Blueprint, autenticação e CSRF\ndb.py: conexão, migrações e transações\ncatalog_data.py: snapshot, carga e cobertura\nFunções de módulo, sem classes artificiais por tabela." as Infra
@enduml
